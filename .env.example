# Houville-diffusion — variables d'environnement par composant

# URL du projet Supabase — utilisée par les trois composants.
SUPABASE_URL=

# vercel-app + whatsapp-worker uniquement.
# Accès serveur privilégié ; ne jamais exposer dans webapp-oedicneme.
SUPABASE_SERVICE_ROLE_KEY=

# webapp-oedicneme uniquement.
# Lecture publique contrôlée par RLS.
SUPABASE_ANON_KEY=

# whatsapp-worker uniquement.
# Mot de passe PostgreSQL direct utilisé par whatsmeow/sqlstore pour persister la session.
# Ce n'est PAS une clé API Supabase.
SUPABASE_DB_PASSWORD=

# vercel-app/api/cron/scrape.ts — protège l'endpoint appelé par Vercel Cron.
CRON_SECRET=

# vercel-app — lien Œdicnème ajouté aux messages WhatsApp.
# Production actuelle : https://webapp-oedicneme.vercel.app
WEBAPP_URL=

# vercel-app/lib/scraper/pdf.ts — OCR des comptes rendus PDF scannés.
OCR_SPACE_API_KEY=

# whatsapp-worker — identifiant JID du groupe WhatsApp cible.
# Exemple de format : 123456789-987654321@g.us
WHATSAPP_GROUP_JID=

# whatsapp-worker — optionnel ; AlwaysData peut injecter le port.
PORT=
