# Supabase — partagé par vercel-app, webapp-oedicneme et whatsapp-worker.
# ATTENTION : deux clés différentes selon le composant (voir plan-houville.md, section
# "Variables d'environnement"). service_role a un accès total (écriture, contourne RLS) —
# à réserver aux composants privés (vercel-app, whatsapp-worker). webapp-oedicneme est
# public : toujours utiliser la clé anon (lecture seule via RLS).
SUPABASE_URL=

# vercel-app + whatsapp-worker uniquement (jamais dans webapp-oedicneme)
SUPABASE_SERVICE_ROLE_KEY=

# webapp-oedicneme uniquement (jamais service_role côté public)
SUPABASE_ANON_KEY=

# vercel-app/api/cron/scrape.ts — protection du endpoint cron
CRON_SECRET=

# vercel-app/lib/scraper/whatsapp-templates.ts — lien vers la webapp Œdicnème inclus dans
# chaque message de diffusion WhatsApp (ex. https://oedicneme.vercel.app)
WEBAPP_URL=

# vercel-app/lib/scraper/pdf.ts — OCR des comptes rendus scannés (PDF sans couche de texte).
# Inscription gratuite sur https://ocr.space/ocrapi (25 000 requêtes/mois, largement
# suffisant ici). Ne pas utiliser la clé démo "helloworld" en production : elle est
# partagée entre tous les utilisateurs et pas fiable pour un usage régulier.
OCR_SPACE_API_KEY=

# whatsapp-worker — numéro WhatsApp personnel qui demande le pairing code, format E.164
# (ex. +33612345678). La session elle-même (creds + Signal keys) est générée à la première
# connexion et persistée automatiquement dans baileys_auth_state, pas de valeur à mettre ici.
WHATSAPP_PHONE_NUMBER=

# whatsapp-worker — identifiant du groupe WhatsApp cible (JID, ex. 123456789-987654321@g.us).
# Se récupère en listant les groupes dont le compte est déjà membre au premier démarrage
# (voir plan-houville.md, section H).
WHATSAPP_GROUP_JID=
